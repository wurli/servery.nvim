{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "disable": [
      "unnecessary-if",
      "unnecessary-assert"
    ]
  },
  "runtime": {
    "requirePattern": [
      "?/init.lua",
      "?.lua"
    ],
    "version": "LuaJIT"
  },
  "workspace": {
    "ignoreGlobs": [
      "*.log"
    ],
    "library": [
      "$VIMRUNTIME/lua",
	  "$HOME/.local/share/nvim/lazy/snacks.nvim/",
	  "$HOME/.local/share/nvim/lazy/fzf-lua/"
    ],
    "workspaceRoots": [
      "./lua"
    ]
  }
}
